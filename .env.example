# Copy to .env (never commit the real file) -- used by docker-compose.yml
# Generate a secret with:  openssl rand -hex 32
SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me-too

# 1 = load demo staff/patients on first start. Set to 0 for real use.
SEED_DEMO_DATA=1

# Sign-in lockout (per username, per server process)
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# Hours a login token stays valid is TOKEN_MINUTES (default 480)
# TOKEN_MINUTES=480
# Comma-separated browser origins allowed to call the API directly
# CORS_ORIGINS=http://localhost:5173
